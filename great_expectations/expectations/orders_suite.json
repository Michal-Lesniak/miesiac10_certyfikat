{
  "expectation_suite_name": "orders_suite",
  "data_asset_type": "SparkDFDataset",
  "meta": {
    "owner": "data-team",
    "sla_hours": 1
  },
  "expectations": [
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": {"min_value": 1, "max_value": 10000000}
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {"column": "order_id"}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "order_id"}
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {"column": "order_id"}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "customer_id"},
      "meta": {"severity": "warn"}
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "status",
        "value_set": ["pending", "paid", "shipped", "delivered", "cancelled", "refunded"]
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {"column": "amount", "min_value": 0.01, "max_value": 100000}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {"column": "amount"}
    },
    {
      "expectation_type": "expect_column_pair_values_a_to_be_greater_than_b",
      "kwargs": {
        "column_A": "updated_at",
        "column_B": "created_at",
        "or_equal": true
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_of_type",
      "kwargs": {"column": "amount", "type_": "DoubleType"}
    },
    {
      "expectation_type": "expect_order_amount_matches_items",
      "kwargs": {
        "column_A": "amount",
        "column_B": "items_total",
        "tolerance": 0.01,
        "mostly": 0.99
      },
      "meta": {"severity": "error", "note": "Custom expectation — amount ≈ SUM(order_items.line_total)"}
    }
  ]
}
